rule get_KR_stats: 
	output: 
		bwa_out = expand(output_dir + "/summary/bwa_{line_family}_stats.txt" ,line_family=LINE_FAMILIES),
		star_out = expand(output_dir + "/summary/star_{line_family}_stats.txt", line_family=LINE_FAMILIES)
	params:
		KR_families_bwa = output_dir + "/analysis/bed/"+ sample_name + "_" + te_name + "_*_bwa.tsv",
		KR_families_star = output_dir +  "/analysis/bed/"+ sample_name + "_" + te_name + "_*_star.tsv"
	run:
		print("starting rule") 
		KR_families_bwa_list = glob.glob(params.KR_families_bwa)
		KR_families_star_list = glob.glob(params.KR_families_star)
		kr_stats = {aligner: {subfamily : [] for subfamily in LINE_FAMILIES} for aligner in ["bwa", "star"]}
		print(KR_families_bwa_list)
		for kr_bwa in KR_families_bwa_list:
			file_name = kr_bwa.split('/')[-1]
			df = pd.read_table(kr_bwa)
			df["peak_frac"] = df.iloc[:,15]/(df.iloc[:,14]+1)
			on_target_ratio = df["peak_frac"].sum() * 1000000
			num_passing = len( df.loc[(df["peak_frac"]*1000000 >= 40 ) & ( df.iloc[:,12] >= 200 ) ] )
			if (file_name.split('_')[-2] in kr_stats["bwa"].keys()):
				if(kr_stats["bwa"][file_name.split('_')[-2]]):
					kr_stats["bwa"][file_name.split('_')[-2]]["sample"].append(file_name)
					kr_stats["bwa"][file_name.split('_')[-2]]["on_target_ratio"].append(on_target_ratio)
					kr_stats["bwa"][file_name.split('_')[-2]]["num_peaks_passing"].append(num_passing)
				else:
					kr_stats["bwa"][file_name.split('_')[-2]] = {"sample" : [file_name] , "on_target_ratio" : [on_target_ratio], "num_peaks_passing" : [num_passing]}
			for kr_star in KR_families_bwa_list:
				file_name = kr_star.split('/')[-1]
				df = pd.read_table(kr_star)
				df["peak_frac"] = df.iloc[:,15]/(df.iloc[:,14]+1)
				on_target_ratio = df["peak_frac"].sum() * 1000000
				num_passing = len(df.loc[(df.iloc[:,15]*1000000 > 40 ) & ( df.iloc[:,12] > 200 ) ] )
				if (file_name.split('_')[-2] in kr_stats["star"].keys()):
					if(kr_stats["star"][file_name.split('_')[-2]]):
						kr_stats["star"][file_name.split('_')[-2]]["sample"].append(file_name)
						kr_stats["star"][file_name.split('_')[-2]]["on_target_ratio"].append(on_target_ratio)
						kr_stats["star"][file_name.split('_')[-2]]["num_peaks_passing"].append(num_passing)
					else:
						kr_stats["star"][file_name.split('_')[-2]] = {"sample" : [file_name] , "on_target_ratio" : [on_target_ratio], "num_peaks_passing" : [num_passing]}
				for i in range(len(LINE_FAMILIES)):
					bwa_stats_df = pd.DataFrame.from_dict(kr_stats["bwa"][LINE_FAMILIES[i]])
					bwa_stats_df.to_csv(output.bwa_out[i], sep="\t", header=True,index=False)
					star_stats_df = pd.DataFrame.from_dict(kr_stats["star"][LINE_FAMILIES[i]])
					print("writing file") 
					star_stats_df.to_csv(output.star_out[i], sep="\t", header=True, index=False)

rule get_KR_insertions:
	output:
		bwa_pass_filter = output_dir + "/summary/KR_merged.bed" ,
		bwa_pass_filter_enough_cells = output_dir + "/summary/KR_merged_pass.bed",
		exist = output_dir + "/summary/KR_exists.mat",
		raw_depth = output_dir + "/summary/KR_raw_depth.mat",
		rel_depth = output_dir + "/summary/KR_rel_depth.mat"
	params:
		KR_families_bwa = output_dir + "/analysis/bed/" + sample_name+ "_" + te_name + "_L1HS_bwa.tsv",
		num_cells = num_cells 
	shell:
		"for i in $(ls {params.KR_families_bwa} ); do awk '$16/($15+1)*1000000 >= 40 && $13>=200 ' $i | cut -f 1-6 ; done | sortBed -i stdin | mergeBed -i stdin -c 1 -o count | awk '{{OFS=\"\\t\"; print $1,$2,$3,\"All_v5_L1HS-bwa_pe-KR-\"NR,$4,\"0\"}}' | sort -k4,4 > {output.bwa_pass_filter} \n"
		"awk '$5 > {params.num_cells}' {output.bwa_pass_filter} > {output.bwa_pass_filter_enough_cells} \n" #Not sure this is right for single or many cell samples
		"for i in $(ls {params.KR_families_bwa} ) ; do intersectBed -loj -a {output.bwa_pass_filter} -b $i |  awk '{{OFS=\"\\t\";if ($10==\".\") {{print $4,\"0\",\"0\",\"0\"}} else {{print $4,\"1\",$22,$22/($21+1)*1000000}}}}'| sort -V | bedtools groupby -g 1 -c 2,3 -o max,max  >  $i.KR_exist; done \n " #uncertain about correctness of the sort parameter
		"for i in $(ls {params.KR_families_bwa}.KR_exist | awk -F / '{{print $NF}}' ) ; do cut -f 2 {output_dir}/analysis/bed/$i > {tmp_dir}$i.2 ; cut -f 3 {output_dir}/analysis/bed/$i > {tmp_dir}$i.3 ; cut -f 4 {output_dir}/analysis/bed/$i > {tmp_dir}$i.4; done \n"
		"echo \"Chr     Start   End     Name    Value   Strand  \" $(ls {params.KR_families_bwa}.KR_exist | xargs -I % basename % | sort -V |cut -d'_' -f 1 | sed ':a;N;$!ba;s/\\n/\\t/g'  ) | tee {output.exist} {output.raw_depth} {output.rel_depth}   \n"
		"paste  {output.bwa_pass_filter} $(ls {tmp_dir}*KR_exist.2) >> {output.exist}  \n"
		"paste  {output.bwa_pass_filter} $(ls {tmp_dir}*KR_exist.3) >> {output.raw_depth}  \n"
		"paste  {output.bwa_pass_filter} $(ls {tmp_dir}*KR_exist.4) >> {output.rel_depth}  \n"

rule get_KNR_stats:
	output:
		knr_out = output_dir + "/summary/knr_stats.txt"
	params:
		KNR_insertion_pattern = output_dir  + "/analysis/tsv/" + sample_name + "_" + te_name + "_KNR_STAR.tsv" 
	run:
		KNR_insertion_list = glob.glob(params.KNR_insertion_pattern)
		knr_stats =  []
		for knr_insertion_file in KNR_insertion_list:
			knr_insertion = pd.read_table(knr_insertion_file)
			passing = len(knr_insertion.loc[ ( (knr_insertion.iloc[:,8] / (knr_insertion.iloc[:,7] + 1)) * 1000000 >= 300 ) & ( pd.to_numeric(knr_insertion.iloc[:,9]) >= 10) ])  #Check these columns are correct with the intersect not ! awk version
			knr_stats.append({"sample" : knr_insertion , "num_peaks_passing" : passing})
		knr_stats_df = pd.DataFrame.from_dict(knr_stats)
		knr_stats_df.to_csv(output.knr_out, sep="\t", header=True, index=False)

rule get_KNR_insertions:
	output:
		KNR_pass_filter_unsorted = output_dir + "/summary/KNR_merged_unsorted.bed",
		KNR_pass_filter = output_dir + "/summary/KNR_merged.bed" ,
		KNR_pass_filter_enough_cells = output_dir + "/summary/KNR_merged_pass.bed",
		exist = output_dir + "/summary/KNR_exists.mat",
		depth = output_dir + "/summary/KNR_depth.mat",
		raw_depth = output_dir + "/summary/KNR_raw_depth.mat",
		rel_depth = output_dir + "/summary/KNR_rel_depth.mat"
	params:
		KNR_families = output_dir  + "/analysis/tsv/" + sample_name + "_" + te_name + "_KNR_STAR.tsv", 
		num_cells = num_cells
	shell:
		"for i in $(ls {params.KNR_families} ); do awk '$9/($8+1)*1000000 >= 300 && $10>=10 ' $i | cut -f 1-6 ; done | sortBed -i stdin | mergeBed -S +  -i stdin -c 1 -o count | awk '{{OFS=\"\\t\"; print $1,$2,$3,\"All_v5_L1HS-bwa_pe-KR-\"NR,$4,\"+\"}}' | sort -k4,4 > {output.KNR_pass_filter_unsorted} \n"
		"for i in $(ls {params.KNR_families} ); do awk '$9/($8+1)*1000000 >= 300 && $10>=10 ' $i | cut -f 1-6 ; done | sortBed -i stdin | mergeBed -S -  -i stdin -c 1 -o count | awk '{{OFS=\"\\t\"; print $1,$2,$3,\"All_v5_L1HS-bwa_pe-KR-\"NR,$4,\"-\"}}' | sort -k4,4 >> {output.KNR_pass_filter_unsorted} \n"
		"sort -k4,4 {output.KNR_pass_filter_unsorted} > {output.KNR_pass_filter} \n"
		"awk '$5 > {params.num_cells}' {output.KNR_pass_filter} > {output.KNR_pass_filter_enough_cells} \n"
		"for i in $(ls {params.KNR_families} ) ; do intersectBed -loj -a {output.KNR_pass_filter} -b $i |  awk '{{OFS=\"\\t\";if ($10==\".\") {{print $4,\"0\",\"0\",\"0\"}} else {{print $4,\"1\",$15,$15/($14+1)*1000000}}}}'| sort -V | bedtools groupby -g 1 -c 2,3 -o max,max  >  $i.KNR_exist; done \n " #uncertain about correctness of the sort parameter
                "for i in $(ls {params.KNR_families}.KNR_exist | awk -F / '{{print $NF}}' ) ; do cut -f 2 {output_dir}/analysis/tsv/$i > {tmp_dir}$i.2 ; cut -f 3 {output_dir}/analysis/tsv/$i > {tmp_dir}$i.3 ; cut -f 4 {output_dir}/analysis/tsv/$i > {tmp_dir}$i.4; done \n"
		"echo \"Chr     Start   End     Name    Value   Strand  \" $(ls {params.KNR_families}.KNR_exist | xargs -I % basename % | sort -V |cut -d'_' -f 1 | sed ':a;N;$!ba;s/\\n/\\t/g'  ) | tee {output.exist} {output.raw_depth} {output.rel_depth}  {output.depth} \n"
		"paste  {output.KNR_pass_filter} $(ls {tmp_dir}*KNR_exist.2) >> {output.exist}  \n"
		"paste  {output.KNR_pass_filter} $(ls {tmp_dir}*KNR_exist.3) >> {output.raw_depth}  \n"
		"paste  {output.KNR_pass_filter} $(ls {tmp_dir}*KNR_exist.4) >> {output.rel_depth}  \n"


rule get_UNK:
	input:
		UNK_insertion_file = output_dir   + "/analysis/tsv/" + sample_name + "_" + te_name  + "_unk_calling.tsv"
	output:
		stats = output_dir +  "/summary/UNK_stats.table",
		#exist = output_dir + "/summary/UNK_exist.mat",
                #raw_depth = cells_path + "/summary/UNK_raw_depth.mat",
                #rel_depth = cells_path + "/summary/UNK_rel_depth.mat",
		merged_unsorted = output_dir  + "/summary/UNK_big_table.table.unsorted" ,
		merged = output_dir  + "/summary/UNK_big_table.table",
		candidates = output_dir  + "/summary/UNK_candidates.table",
		unk_candidates = output_dir  + "/summary/UNK_candidates_final.table" ,
                #verified = cells_path + "/summary/UNK_validated.table"
		
	#params:
		#UNK_insertion_pattern = expand( cells_path + "/" + {cells} + "/analysis/tsv/" + {cells} + "L1HS_unk_calling.tsv" #unk_calling = tsv_path + "_unk_calling.tsv"
		#iUNK_insertion_pattern = cells_path + "/*/analysis/tsv/*L1HS_unk_calling.tsv" ,
		#num_cells = num_cells	
	shell:
		"mkdir -p {output_dir}/summary \n"
		"mergeBed -d 1100 -S + -i <(sortBed -i <( tail -n +2 {input.UNK_insertion_file} | cut -f 1-6  )) -c 1 -o count | awk '{{OFS=\"\\t\"; print $1,$2,$3,\"All_{te_name}-PassN-plus-\"NR,$4,\"+\"}}' > {output.merged_unsorted} \n"
		"mergeBed -d 1100 -S - -i <(sortBed -i <(tail -n +2 {input.UNK_insertion_file} | cut -f 1-6 )) -c 1 -o count | awk '{{OFS=\"\\t\"; print $1,$2,$3,\"All_{te_name}-PassN-minus-\"NR,$4,\"-\"}}' >> {output.merged_unsorted} \n" 
		"sort -k4,4 {output.merged_unsorted} > {output.merged} \n" #to keep the rows consistent for pasting tables later 
		"intersectBed -wao -s -a {output.merged} -b {input.UNK_insertion_file} | awk '{{OFS=\"\\t\";if ($7==\"0\" || $7 == \".\") {{print $1,$2,$3,$4,$6,\"0\",\"0\",\"0\"}} else {{print $1,$2,$3,$4,$6,\"1\",$11,$11/($13+1)*1000000}}}}' | sort -V | bedtools groupby -g 4 -c 1,2,3,5,6,7,8 -o distinct,distinct,distinct,distinct,max,max,max | awk '{{OFS=\"\\t\"; print $2,$3,$4,$1,$6,$5,$7,$8 }}' | sort -k4,4 > {output.stats} \n" 
		"awk '$NF >= 100' {output.stats} > {output.candidates} \n" 
		"intersectBed -s -wa -wb -a <(sort -k1,1 -k2,2n {output.candidates}) -b {input.UNK_insertion_file} | sortBed -i - | uniq > {output.unk_candidates} \n "
		#		"intersectBed -s -wa -wb -a  {output.candidates}  -b <(awk '{{split($NF,a\",\");if (length(a) >=5 && a[1]>=3 && a[2]>=3 && a[3]>=3) print}}' {input.UNK_insertion_file} )| sortBed -i - | cut -f 1-6,13,14 | uniq > {output.unk_candidates} \n" 

#		"for i in $(ls {input.UNK_insertion_file}); do  intersectBed -wao -s -a {output.merged} -b $i | awk '{{OFS=\"\\t\";if ($7==\"0\" || $7 == \".\") {{print $4,\"0\",\"0\",\"0\"}} else {{print $4,\"1\",$11,$11/($13+1)*1000000}}}}'| sort -V | bedtools groupby -g 1 -c 2,3,4 -o max,max,max | sort -k1,1 > $i.merged ; done\n" # important to sort so that we can add a header and know which is which 
#		" for i in $(ls {input.UNK_insertion_file}.merged | awk -F / '{{print $NF}}' ) ; do cut -f 2 {output_dir}/*/analysis/tsv/$i > {tmp_dir}$i.2 ; cut -f 3 {cells_path}/*/analysis/tsv/$i > {tmp_dir}$i.3 ; cut -f 4 {cells_path}/*/analysis/tsv/$i > {tmp_dir}$i.4 ; done \n"
#		"echo \"Chr	Start	End	Name	Value	Strand	\" $(ls {params.UNK_insertion_pattern}.merged | xargs -I % basename % | sort -V |cut -d'_' -f 1 | sed ':a;N;$!ba;s/\\n/\\t/g'  ) | tee {output.exist} {output.raw_depth} {output.rel_depth}  \n"
#		"paste  {output.merged} $(ls {tmp_dir}*merged.2) >> {output.exist}  \n"
#		"paste {output.merged} $(ls {tmp_dir}*merged.3) >> {output.raw_depth} \n"
#		"paste  {output.merged} $(ls {tmp_dir}*merged.4) >> {output.rel_depth} \n"
		
#		"tail -n +2 {output.rel_depth} | awk '{{OFS=\"\\t\"; max=$7; for(i=8;i<=NF;i++) {{if ($i>max) {{max=$i}} }} print $0,max }}' | awk '$NF >= 100' > {output.candidates} \n"
#		"for i in $(ls {params.UNK_insertion_pattern} ); do intersectBed -s -wa -wb -a <(cut -f 1-6 {output.candidates} ) -b <(awk '{{split($NF,a,\",\");if (length(a) >= 5 && a[1]>=3 && a[2]>=3 && a[3]) print}}' $i) | sortBed -i - | cut -f 1-6,13,14 | uniq >  $i.UNK ; done \n"
#		"cat {params.UNK_insertion_pattern}.UNK | sortBed -i - | mergeBed -i stdin -S - -c 1 -o count | awk '$NF >= {min_to_pass}' | awk -v count={params.num_cells} '{{OFS=\"\\t\"; print $1,$2,$3,\"UNK-minus-\"NR,$4\"/\"count,\"-\"}}' > {output.merged_candidates} \n"
#		"cat {params.UNK_insertion_pattern}.UNK | sortBed -i - | mergeBed -i stdin -S + -c 1 -o count | awk '$NF >= {min_to_pass}' | awk -v count={params.num_cells} '{{OFS=\"\\t\"; print $1,$2,$3,\"UNK-plus-\"NR,$4\"/\"count,\"+\"}}' >> {output.merged_candidates} \n" 
		
