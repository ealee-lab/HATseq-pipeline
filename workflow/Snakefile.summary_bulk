rule get_somatic: 
	input:
		UNK_insertion_file = output_dir   + "/analysis/tsv/" + sample_name + "_" + te_name  + "_unk_calling.tsv",
		#UNK_rawdepth =  output_dir  + "/summary/UNK_raw_depth.mat",
		unk_candidates =  output_dir  + "/summary/UNK_candidates_final.table"
	output:
		#merged_somatic_unsorted = output_dir  + "/summary/SOM_merged_unsorted.table",
		#merged_somatic = output_dir  + "/summary/SOM_merged.table",
		#exist = cells_path + "/summary/SOM_exist.mat",
		#raw_depth  = cells_path + "/summary/SOM_raw_depth.mat",
		#rel_depth = cells_path + "/summary/SOM_rel_depth.mat",
		#candidates = cells_path + "/summary/SOM_candidates.table",
		#som_highconf_rawdepth = cells_path + "/summary/SOM_highConf_raw_depth.mat",
		#som_highconf_exist = cells_path + "/summary/SOM_highConf_exist.mat",
		som_highconf_clonal = output_dir  + "/summary/SOM_highConf_clonal.mat",
		som_highconf_private = output_dir  + "/summary/SOM_highConf_private.mat"
	params:
		#pass_reads_pattern = cells_path + "/*/analysis/tsv/*_L1HS_unk_calling.tsv",
