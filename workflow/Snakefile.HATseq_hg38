#Define QC and preprocessing files 
#QC output
illumina_adapter_trimmed_fastq1 = analysis_path + "illumina_adapter_trimmed_fastq1.gz"
illumina_adapter_trimmed_fastq2 = analysis_path + "illumina_adapter_trimmed_fastq2.gz"
