fastqc_report_path = analysis_path + "fastqc_report/"
#Preprocessing output        
L1HS_adapter_trimmed_fromR2_fastq1 = analysis_path + "L1HS_adapter_trimmed_fromR2_fastq1.gz"
L1HS_adapter_trimmed_fromR2_fastq2 = analysis_path + "L1HS_adapter_trimmed_fromR2_fastq2.gz"
L1HS_primer_trimmed_fromR2_fastq1 = analysis_path + "L1HS_primer_trimmed_fromR2_fastq1.gz"
L1HS_primer_trimmed_fromR2_fastq2 = analysis_path + "L1HS_primer_trimmed_fromR2_fastq2.gz"
subfamily_specific_R2_list = analysis_path + "subfamily_specific_R2_list.txt"
L1HS_adapter_trimmed_fromR1_fastq1 = analysis_path + "L1HS_adapter_trimmed_fromR1_fastq1.gz"
L1HS_primer_trimmed_fromR1_fastq1 = analysis_path + "L1HS_primer_trimmed_fromR1_fastq1.gz"
L1HS_untrimmed_fromR1_fastq1 = analysis_path + "L1HS_untrimmed_fromR1_fastq1.gz"
mappable_R1_list = analysis_path + "mappable_R1_list.txt"
mappable_R1_fastq1 = analysis_path + "mappable_R1_fastq1.gz"
mappable_R1_L1HSsequence_trimmed_fromR1_fastq1 = analysis_path + "mappable_R1_L1HSsequence_trimmed_fromR1_fastq1.gz"
