#Alignment output
bwa_bam =  analysis_path + "bwa.bam"
uniq_bam = analysis_path + "uniq_bwa.bam"
uniq_sorted_bam = analysis_path + "uniq_sorted_bwa.bam"
uniq_sorted_bam_index = analysis_path + "uniq_sorted_bwa.bam.bai"

#Peak calling 
peaks = analysis_path + "peaks.bed" 
minus_breakpoint_fa = analysis_path + "minus_breakpoint.fa"
plus_breakpoint_fa = analysis_path + "plus_breakpoint.fa" 
breakpoint_fa = analysis_path + "breakpoint.fa"
unique_start_positions = analysis_path + "unique_start_positions.bed"
intersect_annotated = analysis_path + "intersect_annotated.bed"
#Filter files 
pass_gmotif_list = analysis_path + "pass_gmotif_list.txt" 
Ntag_pre_fastq2 = analysis_path + "Ntag_pre_fastq2.gz"
Ntag_trimmed_fastq2 = analysis_path + "Ntag_trimmed_fastq2.gz"
Ntag_list = analysis_path + "Ntag_list.txt"
softclip3p_fasta = analysis_path + "softclip_3p.fa.gz"
softclip5p_fasta = analysis_path + "softclip_5p.fa.gz"
hardclip3p_table = analysis_path + "hardclip_3p.tsv"
hardclip5p_table = analysis_path + "hardclip_5p.tsv"
peak_seq = analysis_path +  "peak_sequence.fa"
chimera = analysis_path + "chimera.txt"
nonchimera = analysis_path + "nonchimera.txt"
PTA_artifact = analysis_path + "PTA_artifact.txt"
transduction_fasta = analysis_path + "custom_transduction.fasta"
transduction_fasta_index = analysis_path + "custom_transduction.fasta.bwt"
softclip3p_trimmed_fasta = analysis_path + "softclip_3p_trimmed.fa.gz"
softclip5p_trimmed_fasta = analysis_path + "softclip_5p_trimmed.fa.gz"
softclip3p_trimmed_bam = analysis_path + "softclip_3p_trimmed.bam"
softclip5p_trimmed_bam = analysis_path + "softclip_5p_trimmed.bam"
transduction_bed = analysis_path + "custom_transduction.bed"
softclip3p_trimmed_bed = analysis_path + "softclip_3p_trimmed.bed"
softclip5p_trimmed_bed = analysis_path + "softclip_5p_trimmed.bed"
peak_readID_list = analysis_path + "peak_readID_list.txt"
peak_custompeak_list = analysis_path + "peak_custompeak_list.txt"
hardclip3p_bed = analysis_path + "hardclip_3p.bed"
hardclip5p_bed = analysis_path + "hardclip_5p.bed"
big_table = analysis_path + "big_table.tsv"
nearby_peaks = analysis_path + "nearby_peaks.tsv"
