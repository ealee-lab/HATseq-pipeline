rule multi_sample_classification:
	input:
		sample_peaks = lambda wildcards: expand("{name}/{name}_classified_peaks.bed", 
												  name=get_donor_samples(wildcards, samples))
	output:
		donor_peaks = "all_{donor}_candidate_peaks.bed",
		multi_peaks = "{donor}_multi_peaks.bed"
	benchmark:
		"benchmarks/multi_sample_classification/{donor}.tsv"
	params:
		num_samples = lambda wildcards, input: len(input.sample_peaks)
	resources:
		runtime = 10, #get_min_runtime,
		mem_mb = 4000 #get_filter_and_classify_mem_mb,
	group: "classify"
	shell:
		"if [[ {params.num_samples} -ge 3 ]]; then "
			"python {workflow.basedir}/scripts/multi_classify.py "
				"-d {wildcards.donor} "
				"-f {input.sample_peaks} "
				"-p {output.donor_peaks} "
				"-m {output.multi_peaks} \n"
		"else "
			"touch {output.multi_peaks} \n"
			"echo 'chrm\tstart\tend\tpeak\tRPM\tstrand\tclassification\tfilter_reason' "
				"> {output.donor_peaks} \n"
			"cat {input.sample_peaks} >> {output.donor_peaks} \n"
		"fi"	
		