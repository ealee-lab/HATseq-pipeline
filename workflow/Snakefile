ONT1019 = REFERENCE_DIR + "/1019_ONT/1019_ONT_Schloissnig2025.bed"

localrules: HATseq

rule HATseq:
	input:
		expand([
		"{sample}/{sample}_mappable_R1_list.txt",
		"{sample}/{sample}_peak_sorted_bwa.bam",
		"{sample}/{sample}_Ntag_list.txt",
		"{sample}/{sample}_pass_gmotif_list.txt",
		"{sample}/{sample}_polyT_reads.txt",
		"{sample}/{sample}_peaks.bed",
		"{sample}/{sample}_unique_start_positions.bed",
		"{sample}/{sample}_chimera_hash.txt",
		"{sample}/{sample}_intersect_annotated.bed",
		"{sample}/{sample}_big_table.tsv",
		"{sample}/{sample}_classified_peaks.bed",
		"{sample}/{sample}_custom_transduction.fasta",
		"{sample}/{sample}_transduction_plots.pdf",
		"{donor}_multi_peaks.bed"
		],
		sample=samples.index,
		donor=samples["donor"].unique()) 

rule qc: 
	input:
		raw_fastq1 = lambda wildcards: samples.loc[wildcards.sample]["raw_fastq1"],
		raw_fastq2 = lambda wildcards: samples.loc[wildcards.sample]["raw_fastq2"]
	output:
		illumina_adapter_trimmed_fastq1 = "{sample}/{sample}_illumina_adapter_trimmed_fastq1.gz",
		illumina_adapter_trimmed_fastq2 = "{sample}/{sample}_illumina_adapter_trimmed_fastq2.gz",
		fastp_html_report = "{sample}/reports/{sample}_fastp.html",
		fastp_json_report = "{sample}/reports/{sample}_fastp.json"
	benchmark:
		"benchmarks/qc/{sample}.tsv"
	params:
		illumina_adapter = "AGATCGGAAGAGC",
		length_req = 50,
		report_path = lambda wildcards: f"{wildcards.sample}/reports"
	threads: 4
	resources:
		runtime = get_qc_runtime,
		mem_mb = get_qc_mem_mb
	shell:
		"fastp -w {threads} -a {params.illumina_adapter} --length_required={params.length_req} "
			"-i {input.raw_fastq1} -I {input.raw_fastq2} "
			"-o {output.illumina_adapter_trimmed_fastq1} -O {output.illumina_adapter_trimmed_fastq2} "
			"-h {output.fastp_html_report} "
			"-j {output.fastp_json_report} \n" # Run fastp 

		"mkdir -p {params.report_path} && "
			"fastqc -t {threads} --noextract --nogroup "
				"-o {params.report_path} "
				"{input.raw_fastq1} {input.raw_fastq2}" # Run fastqc 

rule preprocessing:
	input:
		illumina_adapter_trimmed_fastq1 = "{sample}/{sample}_illumina_adapter_trimmed_fastq1.gz", 
		illumina_adapter_trimmed_fastq2 = "{sample}/{sample}_illumina_adapter_trimmed_fastq2.gz",
	output:
		L1HS_adapter_trimmed_fromR2_fastq1 = temp("{sample}/{sample}_L1HS_adapter_trimmed_fromR2_fastq1.gz"),
		L1HS_adapter_trimmed_fromR2_fastq2 = temp("{sample}/{sample}_L1HS_adapter_trimmed_fromR2_fastq2.gz"),
		L1HS_primer_trimmed_fromR2_fastq1 = temp("{sample}/{sample}_L1HS_primer_trimmed_fromR2_fastq1.gz"),
		L1HS_primer_trimmed_fromR2_fastq2 = "{sample}/{sample}_L1HS_primer_trimmed_fromR2_fastq2.gz",
		subfamily_specific_R2_list = "{sample}/{sample}_subfamily_specific_R2_list.txt",
		L1HS_adapter_trimmed_fromR1_fastq1 = temp("{sample}/{sample}_L1HS_adapter_trimmed_fromR1_fastq1.gz"),
		L1HS_primer_trimmed_fromR1_fastq1 = temp("{sample}/{sample}_L1HS_primer_trimmed_fromR1_fastq1.gz"),
		L1HS_untrimmed_fromR1_fastq1 = temp("{sample}/{sample}_L1HS_untrimmed_fromR1_fastq1.gz"),
		mappable_R1_list = "{sample}/{sample}_mappable_R1_list.txt",
		mappable_R1_fastq1 = "{sample}/{sample}_mappable_R1_fastq1.gz",
		mappable_R1_L1HSseq_trimmed_fromR1_fastq1 = "{sample}/{sample}_mappable_R1_L1HSsequence_trimmed_fromR1_fastq1.gz",
		mappable_R1_L1HSseq_polyA_trimmed_fromR1_fastq1 = "{sample}/{sample}_mappable_R1_L1HSsequence_polyA_fromR1_fastq1.gz",
		cutadapt_report = "{sample}/reports/{sample}_cutadapt_report.txt"
	benchmark:
		"benchmarks/preprocessing/{sample}.tsv"
	params:
		min_len = 5,
		min_len_informative = 70,
		min_ovlp = 20,
		max_err = 0.05,
		adapter_L1HS = lambda wildcards: samples.loc[wildcards.sample]["index_seq"] + "GGGAGATATACCTAATGCTAGATGACAC",
		adapter_primer = "^TTAGTGGGTGCAGCGCACCA",
		adapter_overlap_L1HS = "GTGTCATCTAGCATTAGGTATATCTCCC",
		adapter_overlap_primer = "TGGTGCGCTGCACCCACTAA$",
		L1PA_young_seq = "TTAGTGGGTGCAGCGCACCAGCATGGCACATGTATACATATGTAACTAACCTGCACAATGTGCACATGTACCCTAAAACTTAGAGT",
		L1HSseq = "ATTATACTCTAAGTTTTAGGGTACATGTGCACATTGTGCAGGTTAGTTACATATGTATACATGTGCCATGCTGGTGCGCTGCACCCACTAATGTGTCATCTAGCATTAGGTATATCTCCC",
		max_err_T = 0,
		adapter_T = "TTTTTTTT" 
	threads: 4
	resources:
		runtime = get_preprocessing_runtime,
		mem_mb = get_preprocessing_mem_mb
	shell:
		"set -x \n"

		# Remove the L1HS adapter from R2 filtering pairs where R2 does not contain the sequence. 
		# R1 and R2 fastqs are swapped and the sequence is with respect to the 5' of R2
		"cutadapt -j {threads} "
			"-m {params.min_len} -g {params.adapter_L1HS} --discard-untrimmed -O 10 -e 0.08 "
			"-p {output.L1HS_adapter_trimmed_fromR2_fastq1} -o {output.L1HS_adapter_trimmed_fromR2_fastq2} "
			"{input.illumina_adapter_trimmed_fastq2} {input.illumina_adapter_trimmed_fastq1} "
			">> {output.cutadapt_report} \n" 

		# Remove the L1HS primer from R2 filtering pairs where R2 does not contain the sequence. 
		# R1 and R2 fastqs are swapped and the sequence is with respect to the 5' of R2
		"cutadapt -j {threads} "
			"-m {params.min_len} -g {params.adapter_primer} --discard-untrimmed -O 5 -e 0.16 "
			"-p {output.L1HS_primer_trimmed_fromR2_fastq1} -o {output.L1HS_primer_trimmed_fromR2_fastq2} "
			"{output.L1HS_adapter_trimmed_fromR2_fastq2} {output.L1HS_adapter_trimmed_fromR2_fastq1} "
			">> {output.cutadapt_report} \n" 

		# Remove R2 that don't contain a sequence specific to the L1PA young subfamily of transposons
		"cutadapt -j {threads} "
			"--discard-untrimmed -g {params.L1PA_young_seq} -e 0.05 -O 20 "
			"{output.L1HS_adapter_trimmed_fromR2_fastq2} | "
			"seqkit seq -i -n - "
			"> {output.subfamily_specific_R2_list} \n" 
		
		# Remove the L1HS adapter from R1
		"cutadapt -j {threads} "
			"-m {params.min_len} -a {params.adapter_overlap_L1HS} -O 5 -e 0.08 "
			"-o {output.L1HS_adapter_trimmed_fromR1_fastq1} "
			"{output.L1HS_primer_trimmed_fromR2_fastq1} "
			">> {output.cutadapt_report} \n" 
		
		# Remove the L1HS primer from R1
		"cutadapt -j {threads} "
			"-m {params.min_len} -a {params.adapter_overlap_primer} -O 5 -e 0.16 "
			"--untrimmed-output {output.L1HS_untrimmed_fromR1_fastq1} "
			"-o {output.L1HS_primer_trimmed_fromR1_fastq1} "
			"{output.L1HS_adapter_trimmed_fromR1_fastq1} "
			">> {output.cutadapt_report} \n" 
		
		"cutadapt -j {threads} "
			"-m {params.min_len_informative} "
			"{output.L1HS_primer_trimmed_fromR1_fastq1} | "
			"seqtk subseq - {output.subfamily_specific_R2_list} | "
			"seqkit seq -i -n -  "
			"> {output.mappable_R1_list} \n"

		# Create list of R1s that have a pair that passed 
		"seqtk subseq {output.L1HS_untrimmed_fromR1_fastq1} {output.subfamily_specific_R2_list} | "
			"seqkit seq -i -n -  "
			">> {output.mappable_R1_list} \n" 

		"seqtk subseq {output.L1HS_adapter_trimmed_fromR2_fastq1} {output.mappable_R1_list} | gzip - "
			"> {output.mappable_R1_fastq1} \n" 

		"cutadapt -j {threads} "
			"-m {params.min_len} -a {params.L1HSseq} -O {params.min_ovlp} -e {params.max_err} "
			"-o {output.mappable_R1_L1HSseq_trimmed_fromR1_fastq1} "
			"{output.mappable_R1_fastq1} "
			">> {output.cutadapt_report} \n"

		"cutadapt -a {params.adapter_T} -e {params.max_err_T} "
			"-o {output.mappable_R1_L1HSseq_polyA_trimmed_fromR1_fastq1} "
			"{output.mappable_R1_L1HSseq_trimmed_fromR1_fastq1} "
			">> {output.cutadapt_report} \n"		
		
rule alignment:
	input:
		ref_genome = REF_GENOME,
		mappable_R1_L1HSseq_trimmed_fromR1_fastq1 = "{sample}/{sample}_mappable_R1_L1HSsequence_trimmed_fromR1_fastq1.gz",
		mappable_R1_L1HSseq_polyA_trimmed_fromR1_fastq1 = "{sample}/{sample}_mappable_R1_L1HSsequence_polyA_fromR1_fastq1.gz"
	output:
		bwa_bam = temp("{sample}/{sample}_bwa.bam"),
		bwa_sorted_bam = "{sample}/{sample}_bwa_sorted.bam", 
		bwa_sorted_index = "{sample}/{sample}_bwa_sorted.bam.bai",
		trim_bwa_bam = temp("{sample}/{sample}_trim_bwa.bam"),
		trim_uniq_bam = temp("{sample}/{sample}_trim_uniq.bam"), 
		trim_uniq_sorted_bam = "{sample}/{sample}_trim_uniq_sorted.bam", # polyT-trimmed reads
		trim_uniq_sorted_index = "{sample}/{sample}_trim_uniq_sorted.bam.bai",
		trim_peaks = "{sample}/{sample}_trim_peaks.bed",
		peak_sorted_bam = "{sample}/{sample}_peak_sorted_bwa.bam",
		peak_sorted_index = "{sample}/{sample}_peak_sorted_bwa.bam.bai"
	benchmark:
		"benchmarks/alignment/{sample}.tsv"
	params:
		RG_ID = lambda wildcards: fr"-R '@RG\tID:{TE_NAME}\tSM:{wildcards.sample}\tPL:{SEQ_PLATFORM}\tLB:HAT-seq\tCN:{SEQ_CENTER}'"
	threads: 8 
	resources:
		runtime = get_alignment_runtime,
		mem_mb = get_alignment_mem_mb
	shell:
		# Map mappable parts of R1 to reference genome
		"bwa mem -t {threads} {params.RG_ID} {input.ref_genome} {input.mappable_R1_L1HSseq_trimmed_fromR1_fastq1} | "
			"samtools view -Sb - "
			"> {output.bwa_bam} \n"
		"samtools sort -o {output.bwa_sorted_bam} {output.bwa_bam} \n"
		"samtools index {output.bwa_sorted_bam} \n"

		"bwa mem -t {threads} {params.RG_ID} {input.ref_genome} {input.mappable_R1_L1HSseq_polyA_trimmed_fromR1_fastq1} | "
			"samtools view -Sb - "
			"> {output.trim_bwa_bam} \n"
			
		# Unique read = read with MAPQ >= 20 and edit distance < 4
		"samtools view -q 20 {output.trim_bwa_bam} | "
			"awk '{{ for (i=1;i<=NF;i++) "
				"{{ if ($i ~/AS:i:/) "
					"{{split ($i,a,\":\")}}; "
				"if ($i ~/XS:i:/) "
					"{{split ($i,b,\":\")}} }}; "
				"if (a[3]>b[3]) print; }}' | "
			"awk '{{ for (i=1;i<=NF;i++) "
				"{{ if ($i ~/NM:i:/) "
					"{{split ($i,a,\":\"); "
				"if (a[3]<4) print; }} }} }}' | "
			"cat <(samtools view -H {output.trim_bwa_bam}) - | "
			"samtools view -Sb - "
			"> {output.trim_uniq_bam} \n"
		"samtools sort -o {output.trim_uniq_sorted_bam} {output.trim_uniq_bam} \n"
		"samtools index {output.trim_uniq_sorted_bam} \n"

		# Find regions (peak) with at least 1 unique read 
		"cat <( genomeCoverageBed -ibam {output.trim_uniq_sorted_bam} -bg -strand \"+\" | "
			"awk '{{OFS=\"\\t\"; print $1,$2,$3,$4,\".\",\"+\",$3-$2}}' ) "
			"<( genomeCoverageBed -ibam {output.trim_uniq_sorted_bam} -bg -strand \"-\" | "
			"awk '{{OFS=\"\\t\"; print $1,$2,$3,$4,\".\",\"-\",$3-$2}}' ) | "
			"sort -k1,1 -k2,2n | "
			"mergeBed -d 1 -i stdin -s -c 1,4,6,7,4 -o count,collapse,distinct,collapse,max | "
			"awk '{{ OFS=\"\\t\"; "
				"if($6 == \"+\") "
					"{{print $1,$2,$3,\"{wildcards.sample}-plus-peak-\"NR,$4\";\"$8\";\"$7\";\"$5,$6}} "
				"else "
					"{{print $1,$2,$3,\"{wildcards.sample}-minus-peak-\"NR,$4\";\"$8\";\"$7\";\"$5,$6}} }}' "
			">> {output.trim_peaks} \n"

		# Output all reads in peak regions
		"samtools view --region-file {output.trim_peaks} {output.bwa_sorted_bam} | "
			"cat <(samtools view -H {output.bwa_bam}) - | "
			"samtools sort -o {output.peak_sorted_bam} - \n"
		"sambamba index {output.peak_sorted_bam} \n"

rule Ntag:
	input:
		illumina_adapter_trimmed_fastq2 = "{sample}/{sample}_illumina_adapter_trimmed_fastq2.gz",
		mappable_R1_list = "{sample}/{sample}_mappable_R1_list.txt"
	output:
		Ntag_pre_fastq2 = "{sample}/{sample}_Ntag_pre_fastq2.gz",
		Ntag_trimmed_fastq2 = "{sample}/{sample}_Ntag_trimmed_fastq2.gz",
		Ntag_list = "{sample}/{sample}_Ntag_list.txt"
	benchmark:
		"benchmarks/Ntag/{sample}.tsv"
	params:
		adapter = lambda wildcards: samples.loc[wildcards.sample]["index_seq"] + "GGGAGATATACCTAATGCTAGATGACAC"
	resources:
		runtime = get_Ntag_runtime,
		mem_mb = get_Ntag_mem_mb
	shell:
		"seqtk subseq {input.illumina_adapter_trimmed_fastq2} {input.mappable_R1_list} | gzip - "
			"> {output.Ntag_pre_fastq2} \n"
		"cutadapt --quiet --discard-untrimmed -a {params.adapter} "
			"-o {output.Ntag_trimmed_fastq2} {output.Ntag_pre_fastq2} \n"
		"seqkit seq -i {output.Ntag_trimmed_fastq2} | "
			"seqtk seq -a - | "
			"awk '{{ if (NR%2) {{printf \"%s%s\", $0, \"\\t\"}} else {{printf \"%s%s\", $0, \"\\n\"}} }}' | "
			"grep '^>' | "
			"cut -b2- "
			"> {output.Ntag_list}"

rule gmotif:
	input:
		mappable_R1_list = "{sample}/{sample}_mappable_R1_list.txt",
		L1HS_adapter_trimmed_fromR2_fastq2 = "{sample}/{sample}_L1HS_adapter_trimmed_fromR2_fastq2.gz"
	output:
		pass_gmotif_list = "{sample}/{sample}_pass_gmotif_list.txt"
	benchmark:
		"benchmarks/gmotif/{sample}.tsv"
	resources:
		runtime = get_gmotif_runtime,
		mem_mb = get_gmotif_mem_mb
	shell:
		"seqtk subseq {input.L1HS_adapter_trimmed_fromR2_fastq2} {input.mappable_R1_list} | "
			"seqtk seq -a - | "
			"grep 'CTTAGAGT' -B 1 | "
			"seqkit seq -i -n - | sort | uniq "
			"> {output.pass_gmotif_list} \n"
	
rule extract_clipping:
	input:	
		peak_sorted_bam = "{sample}/{sample}_peak_sorted_bwa.bam"
	output:
		softclip3p_fasta = "{sample}/{sample}_softclip_3p.fa.gz",
		softclip5p_fasta = "{sample}/{sample}_softclip_5p.fa.gz",
		hardclip3p_table = "{sample}/{sample}_hardclip_3p.tsv",
		hardclip5p_table = "{sample}/{sample}_hardclip_5p.tsv"
	benchmark:
		"benchmarks/run_extract_clipping/{sample}.tsv"
	resources:
		runtime = get_extract_clipping_runtime,
		mem_mb = get_extract_clipping_mem_mb
	run:
		ofasta5p=gzip.open(output.softclip5p_fasta, 'wt')
		otable5p=open(output.hardclip5p_table, 'w')
		ofasta3p=gzip.open(output.softclip3p_fasta, 'wt')
		otable3p=open(output.hardclip3p_table, 'w')
		
		def reverse_complement(seq):
			complement = {'A':'T', 'T':'A', 'G':'C', 'C':'G', 'N':'N'}
			return ''.join(complement[base] for base in reversed(seq))

		ibam=pysam.AlignmentFile(input.peak_sorted_bam, 'rb')
		for read in ibam.fetch(until_eof=True):
			reverse = (read.flag & 16 == 16) 
			if "S" in read.cigarstring:
				if read.cigartuples[0][0] == 4 :
					if reverse: # reverse read and clip is at reference 3' = 5' clipping
						ofasta3p.write(">" + read.query_name + "\n")
						ofasta3p.write(reverse_complement(read.query_sequence[0:read.query_alignment_start-1]) + "\n")
					else:
						ofasta5p.write(">" + read.query_name + "\n")
						ofasta5p.write(read.query_sequence[0:read.query_alignment_start-1] + "\n")	
				elif read.cigartuples[len(read.cigartuples)-1][0] == 4:
					if reverse:
						ofasta5p.write(">" + read.query_name + "\n")
						ofasta5p.write(reverse_complement(read.query_sequence[read.query_alignment_end+1:read.query_length-1]) + "\n")
					else:
						ofasta3p.write(">" + read.query_name + "\n")
						ofasta3p.write(read.query_sequence[read.query_alignment_end+1:read.query_length-1] + "\n")

			if "H" in read.cigarstring:
				if read.cigartuples[0][0] == 5:
					num_alt_mappings = len(read.get_tag("SA").strip(";").split(";"))
					if num_alt_mappings == 1:
						uniq_supp_map = read.get_tag("SA").strip(";").split(";")[0].split(",")
						if int(uniq_supp_map[4]) > 20 and int(uniq_supp_map[5]) < 4: 
							if reverse:
								otable3p.write(read.query_name + "\t" + str(uniq_supp_map[0]) + ":" +  str(uniq_supp_map[1]) + "-" + str(int(uniq_supp_map[1]) + int(read.reference_length)) + ":" + uniq_supp_map[2] + "\n")
							else:
								otable5p.write(read.query_name + "\t" + str(uniq_supp_map[0]) + ":" +  str(uniq_supp_map[1]) + "-" + str(int(uniq_supp_map[1]) + int(read.reference_length)) + ":" + uniq_supp_map[2] + "\n")

				elif read.cigartuples[len(read.cigartuples)-1][0] == 5:
					num_alt_mappings = len(read.get_tag("SA").strip(";").split(";"))
					if num_alt_mappings == 1:
						uniq_supp_map = read.get_tag("SA").strip(";").split(";")[0].split(",")
						if int(uniq_supp_map[4]) > 20 and int(uniq_supp_map[5]) < 4:
							if reverse:
								otable5p.write(read.query_name + "\t" + str(uniq_supp_map[0]) + ":" +  str(uniq_supp_map[1]) + "-" + str(int(uniq_supp_map[1]) + int(read.reference_length)) + ":" + uniq_supp_map[2] + "\n")
							else:
								otable3p.write(read.query_name + "\t" + str(uniq_supp_map[0]) + ":" +  str(uniq_supp_map[1]) + "-" + str(int(uniq_supp_map[1]) + int(read.reference_length)) + ":" + uniq_supp_map[2] + "\n")		

		ofasta5p.close()
		otable5p.close()
		ofasta3p.close()
		otable3p.close()	

rule junction_spanning:
	input:
		softclip3p_fasta = "{sample}/{sample}_softclip_3p.fa.gz"
	output:
		polyT_reads = "{sample}/{sample}_polyT_reads.txt"
	benchmark:
		"benchmarks/junction_spanning/{sample}.tsv"
	params:
		adapter_T = "TTTTTTTT" 
	resources:
		runtime = get_min_runtime,
		mem_mb = get_min_mem_mb
	shell:
		"zcat {input.softclip3p_fasta} | "
			"awk -v RS='>' -F '\n' 'substr($2,1,30) ~ \"{params.adapter_T}\" {{print $1}}' "
			"> {output.polyT_reads}"

rule peak_calling:
	input:
		peak_sorted_bam = "{sample}/{sample}_peak_sorted_bwa.bam",
		ref_genome = REF_GENOME,
		hg38 = HG38,
	output:
		peaks = "{sample}/{sample}_peaks.bed",
		max_depth = "{sample}/{sample}_max_depth_distance_to_boundary.txt",
		breakpoint_fa = "{sample}/{sample}_breakpoint.fa",
		peak_seq = "{sample}/{sample}_peak_sequence.fa"
	benchmark:
		"benchmarks/peak_calling/{sample}.tsv"
	resources:
		runtime = get_peak_calling_runtime,
		mem_mb = get_peak_calling_mem_mb
	group: "peaks"
	shell:
		"echo '#chr\tstart\tend\tpeak_name\tnum_subpeaks;max_depth;length_subpeaks;depth_subpeaks\tstrand' "
			"> {output.peaks} \n"

		"cat <( genomeCoverageBed -ibam {input.peak_sorted_bam} -bg -strand \"+\" | "
			"awk '{{OFS=\"\\t\"; print $1,$2,$3,$4,\".\",\"+\",$3-$2}}' ) "
			"<( genomeCoverageBed -ibam {input.peak_sorted_bam} -bg -strand \"-\" | "
			"awk '{{OFS=\"\\t\"; print $1,$2,$3,$4,\".\",\"-\",$3-$2}}' ) | "
			"sort -k1,1 -k2,2n | "
			"mergeBed -d 1 -i stdin -s -c 1,4,6,7,4 -o count,collapse,distinct,collapse,max | "
			"awk '{{ OFS=\"\\t\"; "
				"if($6 == \"+\") "
					"{{print $1,$2,$3,\"{wildcards.sample}-plus-peak-\"NR,$4\";\"$8\";\"$7\";\"$5,$6}} "
				"else "
					"{{print $1,$2,$3,\"{wildcards.sample}-minus-peak-\"NR,$4\";\"$8\";\"$7\";\"$5,$6}} }}' "
			">> {output.peaks} \n"

		"awk '{{ OFS=\"\\t\"; "
			"split($5,a,\";\"); split(a[4],b,\",\"); split(a[3],c,\",\"); "
			"sum=0; stop=1; "
			"if($6 == \"+\") "
				"{{ for(i=length(b);i>0; i=i-1) "
					"{{ if(b[i] < a[2]) "
						"{{sum=sum+(stop*c[i])}} "
					"else "
						"{{stop=0}} }} }} "
			"else "
				"{{ for(i=1;i<length(b)+1; i=i+1) "
					"{{ if(b[i] < a[2]) "
						"{{sum=sum+(stop*c[i])}} "
					"else "
						"{{stop=0}} }} }} print $4,sum }}' {output.peaks} "
			"> {output.max_depth} \n"

		"slopBed -l 30 -r 0 -s -g {input.hg38} "
			"-i <(awk '{{ OFS=\"\\t\"; "
				"if($6 == \"-\") "
					"{{print $1,$2,$2+1,$4,$5,$6}} "
				"else "
					"{{print $1,$3,$3+1,$4,$5,$6}} }}' {output.peaks}) | "
			"bedtools getfasta -fi {input.ref_genome} -bed stdin -name "
			"> {output.breakpoint_fa} \n"

		"bedtools getfasta -fi {input.ref_genome} -bed {output.peaks} -name > {output.peak_seq} \n"

rule count_templates:
	input:
		peak_sorted_bam = "{sample}/{sample}_peak_sorted_bwa.bam",
		peaks = "{sample}/{sample}_peaks.bed"
	output:
		unique_start_positions = "{sample}/{sample}_unique_start_positions.bed",
		peak_readID_list = "{sample}/{sample}_peak_readID_list.txt"
	benchmark:
		"benchmarks/run_count_templates/{sample}.tsv"
	resources:
		runtime = get_count_templates_runtime,
		mem_mb = get_count_templates_mem_mb
	group: "peaks"
	run:
		ibam=pysam.AlignmentFile(input.peak_sorted_bam,'rb')
		ibed=open(input.peaks, 'r')
		obed=open(output.unique_start_positions, 'w')
		header = ["#peak_name", "num_bam_reads", "num_peak_reads", "num_usp;depth", 
				  "max_neighbor_difference", "median_neighbor_difference", "mean_neighbor_difference"]
		obed.write("\t".join(header) + "\n")
		ibam_total_reads = sum([i[3] for i in ibam.get_index_statistics()])
		peak_readID_list = []
		for peak_line in ibed:
			if peak_line.startswith("#"):
				continue
			peak = peak_line.strip().split("\t")
			peak_iter = ibam.fetch(peak[0], int(peak[1]), int(peak[2]))
			this_peak_usp_dictionary = {}
			for read in peak_iter:
				if read.is_reverse:
					key = read.reference_name + ":" + str(read.reference_end)
				else:
					key = read.reference_name + ":" + str(read.reference_start)

				if peak[5] == "-":
					if read.is_reverse:
						if not key in this_peak_usp_dictionary.keys():
							this_peak_usp_dictionary[key] = (0,0)
						peak_readID_list.append([peak[3], read.query_name])

						this_peak_usp_dictionary[key] = (this_peak_usp_dictionary[key][0]+1,
														 this_peak_usp_dictionary[key][1]+1)
				elif peak[5] == "+":
					if not read.is_reverse:
						if not key in this_peak_usp_dictionary.keys():
							this_peak_usp_dictionary[key] = (0,0)
						peak_readID_list.append([peak[3], read.query_name])

						this_peak_usp_dictionary[key] = (this_peak_usp_dictionary[key][0]+1,
														 this_peak_usp_dictionary[key][1]+1)
			this_peak_total_reads = sum([this_peak_usp_dictionary[key][1] for key in this_peak_usp_dictionary.keys()])
			duplicates_list = [this_peak_usp_dictionary[key][1] for key in this_peak_usp_dictionary.keys()]
			difference_list = []
			if(len(duplicates_list) > 1):
				for i in range(0,len(duplicates_list)-1):
					difference_list.append(abs(duplicates_list[i] - duplicates_list[i+1]))
			else:
				difference_list = [-1]

			duplicates_list.sort(reverse=True)

			obed.write(peak[3] + "\t" + str(ibam_total_reads) + "\t" + str(this_peak_total_reads) + "\t" + str(len(this_peak_usp_dictionary.keys())) + ";" + ",".join(map(str, duplicates_list)) + "\t" + str(max(difference_list)) + "\t" + str(statistics.median(difference_list)) + "\t" + str(statistics.mean(difference_list)) + "\n") 
		with open(output.peak_readID_list, 'w') as list:
			for peak_read in peak_readID_list:
				list.write("\t".join(peak_read) + "\n")
		obed.close()
		ibed.close()

rule chimera:
	input:
		breakpoint_fa = "{sample}/{sample}_breakpoint.fa",
		peak_seq = "{sample}/{sample}_peak_sequence.fa"
	output:
		chimera = "{sample}/{sample}_chimera.txt",
		nonchimera = "{sample}/{sample}_nonchimera.txt",
		misalignment = "{sample}/{sample}_misalignment.txt"
	benchmark:
		"benchmarks/run_chimera/{sample}.tsv"
	resources:
		runtime = get_min_runtime,
		mem_mb = get_min_mem_mb,
	group: "peaks"
	run:
		chimera_list = []
		nonchimera_list = []
		misalignment_list = []
		with open(input.breakpoint_fa) as fa:
			peak = fa.readline().strip("\n").strip(">")
			seq = fa.readline().strip("\n").upper()
			while(peak):
				if "minus" in peak:
					chimera = "A"
				else:
					chimera = "T"
				overall_max = 0
				i = 0	
				while i < len(seq):
					if seq[i] == chimera:
						cur_max = 1
						i = i+1
						if i < len(seq):
							while seq[i] == chimera:
								cur_max = cur_max + 1
								i = i + 1
								if i == len(seq):
									break
						if cur_max > overall_max:
							overall_max = cur_max
					i = i+1
				if overall_max > 12 or (seq.count(chimera) / len(seq)) >= 0.8:
					chimera_list.append(peak)
				else:
					nonchimera_list.append(peak)
				peak = fa.readline().strip("\n").strip(">")
				seq = fa.readline().strip("\n").upper()

		with open(input.peak_seq) as fa:
			peak = fa.readline().strip("\n").strip(">")
			seq = fa.readline().strip("\n").upper()
			while(peak):
				if "minus" in peak:
					chimera = "A"
				else:
					chimera = "T"
				if (seq.count(chimera)/ len(seq) > 0.5): 
					misalignment_list.append(peak)
				peak = fa.readline().strip("\n").strip(">")
				seq = fa.readline().strip("\n").upper()
				
		with open(output.misalignment,'w') as mis:
			mis.write("\n".join(misalignment_list))		
		with open(output.chimera,'w') as chim:
			chim.write("\n".join(chimera_list))
		with open(output.nonchimera,'w') as nonchim:
			nonchim.write("\n".join(nonchimera_list))

rule chimera_hash:
	input:
		breakpoint_fa = "{sample}/{sample}_breakpoint.fa"
	output:
		chimera_hash = "{sample}/{sample}_chimera_hash.txt"
	benchmark:
		"benchmarks/run_chimera_hash/{sample}.tsv"
	resources:
		runtime = get_min_runtime,
		mem_mb = get_min_mem_mb,
	group: "peaks"
	run:
		seqs = open(input.breakpoint_fa , 'r')
		peak = seqs.readline().strip("\n").strip(">") 
		seq = seqs.readline().strip("\n").upper()
		hash = ['AA', 'AC', 'AG', 'AT', 'CA', 'CC', 'CG', 'CT', 'GA', 'GC', 'GG', 'GT', 'TA', 'TC', 'TG', 'TT' ]

		with open(output.chimera_hash, 'w') as chim:
			chim.write("peak\t" + "\t".join(hash) + "\twidth\n")
			while(peak):
				minus_peak = ("minus" in peak)
				peak_hash = []
				for key in hash:
					# Get percent of total possible dimers for each unique dimer
					peak_hash.append(str(seq.count(key) / (len(seq) -2))) 
				chim.write(peak + "\t" + "\t".join(peak_hash)  + "\t" + str(len(seq)) + "\n")
				peak = seqs.readline().strip("\n").strip(">")
				seq = seqs.readline().strip("\n").upper()

