			"awk '{{ OFS=\"\\t\"; split($5,a,\"=\"); split($4,b,\"=\"); max=0; stop=0; "
				"for(i=0; i<length(a); i++) "
					"{{split(a[i],d,\";\"); if(d[2] > max) {{max = d[2]; stop=i}} }} "
					"print b[stop],$4 }}' "
			"> {output.nearby_peaks} \n"

